# AI 模型底座（支持任意兼容 OpenAI 接口的大模型；仅开控制台可暂不填）
AI_API_KEY=your_api_key_here
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# 也兼容旧变量名：DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL

# 自定义系统提示词（默认已内置 WeBot 身份与强防套问指令；未配置则使用默认内置）
# SYSTEM_PROMPT=
# 也兼容别名：AI_SYSTEM_PROMPT=（与 SYSTEM_PROMPT 二选一；整段替换会拿掉默认防套问，运维自担）

# 提问限流与算力保护配置（非法/非数字值回退默认；<=0 关闭该层）
# 额度在「放行调用 AI」时扣除（AI 超时/失败仍计次）；超限提示不调用模型、不扣额度
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_DAY=100

# 每日定时归档与上下文重置（进程本地时区；Docker 镜像已 ENV TZ=Asia/Shanghai）
# 默认凌晨 04:00；非法 ARCHIVE_HOUR/MINUTE 回退 4 / 0
# ARCHIVE_HOUR=4
# ARCHIVE_MINUTE=0
# 非 Docker 本地若要对齐北京时间可设：
# TZ=Asia/Shanghai

# Dokploy 部署（GitHub Actions secrets，不进镜像）
# URL 例：https://hz.yuler.dev
# APPLICATION_ID 从 Dokploy 应用页 URL 复制
DOKPLOY_URL=
DOKPLOY_API_KEY=
DOKPLOY_APPLICATION_ID=

# Remote Production DB Executor (defaults to ~/.ssh/config alias 'hz')
# REMOTE_HOST=hz
# REMOTE_CONTAINER=

# HTTP API（Bun）
# HOST=0.0.0.0
# PORT=3000

# WECHAT_SESSION_FILE=/data/.wechat_session.json

# SQLite (Drizzle)
# SQLITE_PATH=./data/webot.sqlite
# DATABASE_URL=file:./data/webot.sqlite

# Required in production (NODE_ENV=production): strong random ≥16 chars.
# Missing / placeholders (change-me, webot-dev-insecure-secret, …) refuse to start.
# SESSION_SECRET=change-me-to-a-long-random-string
# Production always sets Secure on session cookies; local may force with:
# COOKIE_SECURE=1

# Public site origin for magic-link URLs in emails (required in production HTTPS)
# Do NOT use this for SSR API fetches — see APP_ORIGIN.
# PUBLIC_ORIGIN=https://webot.yuler.dev

# Internal listen URL for server-side / SSR fetches to /api/* (default loopback).
# Set explicitly behind reverse proxies / Dokploy when PUBLIC_ORIGIN is public HTTPS.
# APP_ORIGIN=http://127.0.0.1:3000

# --- Outbound login email (OTP + magic link) ---------------------------------
# Prefer SMTP with the SAME keys as moge (Dokploy: copy from moge app).
# SMTP_ADDRESS=smtp.mxhichina.com
# SMTP_DOMAIN=yuler.cc
# SMTP_PORT=465
# SMTP_USERNAME=noreply@yuler.cc
# SMTP_PASSWORD=
# SMTP_SSL_ENABLED=true
# EMAIL_SENDER=noreply@yuler.cc
# Optional alias (used if EMAIL_SENDER unset): MAIL_FROM=WeBot <noreply@yuler.cc>
#
# Optional Resend fallback (only if SMTP_* are unset):
# RESEND_API_KEY=re_xxx
# MAIL_FROM=WeBot <onboarding@yourdomain.com>
#
# Neither configured → [mail:dev] console + file sink (local):
# OTP_DEV_SINK=./data/otp-dev.log

# WEBOT_SKIP_BOT=1
# Vite UI proxies to this API in web:dev
# WEBOT_API_PROXY=http://127.0.0.1:3000
# WEB_PORT=5173
