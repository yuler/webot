# DeepSeek 官方 API Key（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 接口地址（选填，默认为 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型选择（选填，默认为 deepseek-chat，可选 deepseek-reasoner）
# DEEPSEEK_MODEL=deepseek-chat

# 登录页监听（选填）
# HOST=0.0.0.0
# PORT=3000

# 微信会话文件（选填，生产环境挂到持久卷）
# WECHAT_SESSION_FILE=/data/.wechat_session.json
