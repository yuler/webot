# DeepSeek 官方 API Key（ClawBot 回复需要；仅开控制台可暂不填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek 接口地址（选填，默认为 https://api.deepseek.com）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型选择（选填，默认为 deepseek-chat，可选 deepseek-reasoner）
# DEEPSEEK_MODEL=deepseek-chat

# HTTP 监听（选填）
# HOST=0.0.0.0
# PORT=3000

# 微信会话文件（选填，生产环境挂到持久卷）
# WECHAT_SESSION_FILE=/data/.wechat_session.json

# --- Multi-tenant + email OTP (first slice) ---
# SQLite path (Drizzle). Prefer file path; file: URL also accepted.
# SQLITE_PATH=./data/webot.sqlite
# DATABASE_URL=file:./data/webot.sqlite

# Session cookie signing pepper (change in production)
# SESSION_SECRET=change-me-to-a-long-random-string

# Set COOKIE_SECURE=1 behind HTTPS
# COOKIE_SECURE=1

# Dev OTP sink file (default ./data/otp-dev.log). Codes always log to console when mail unset.
# OTP_DEV_SINK=./data/otp-dev.log

# Optional: send OTP via Resend (otherwise console/dev sink)
# RESEND_API_KEY=re_xxx
# MAIL_FROM=WeBot <onboarding@yourdomain.com>

# Start web console without ClawBot loop (useful for auth UI alone)
# WEBOT_SKIP_BOT=1
