# DeepSeek（ClawBot 回复；仅开控制台可暂不填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# HTTP API（Bun）
# HOST=0.0.0.0
# PORT=3000

# WECHAT_SESSION_FILE=/data/.wechat_session.json

# SQLite (Drizzle)
# SQLITE_PATH=./data/webot.sqlite
# DATABASE_URL=file:./data/webot.sqlite

# SESSION_SECRET=change-me-to-a-long-random-string
# COOKIE_SECURE=1

# OTP_DEV_SINK=./data/otp-dev.log
# RESEND_API_KEY=re_xxx
# MAIL_FROM=WeBot <onboarding@yourdomain.com>

# WEBOT_SKIP_BOT=1
# Vite UI proxies to this API in web:dev
# WEBOT_API_PROXY=http://127.0.0.1:3000
# WEB_PORT=5173

# Public site origin for magic links in emails
# PUBLIC_ORIGIN=https://webot.example.com
